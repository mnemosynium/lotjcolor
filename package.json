{
  "name": "lotjcolor",
  "displayName": "LotJ Color",
  "description": "",
  "version": "1.4.1",
  "publisher": "Mnemosyne",
  "engines": {
    "vscode": "^1.106.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnemosynium/lotjcolor"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.lotjColor",
        "title": "LotJ Color Preview"
      }
    ],
    "configuration": {
      "title": "Lotj Color Preview",
      "properties": {
        "lotjcolor.showColumnGuide": {
          "type": "boolean",
          "default": true,
          "description": "Display a vertical guide at the specified column.",
          "order": "1"
        },
        "lotjcolor.columnGuideWidth": {
          "type": "number",
          "default": 80,
          "description": "Column number at which to show the vertical guide.",
          "order": "2"
        },
        "lotjcolor.breakbetweenlines": {
          "type": "boolean",
          "default": true,
          "description": "Include a blank line-break between lines.",
          "order": "3"
        },
        "lotjcolor.displayfont": {
          "type": "string",
          "default": "'Courier New', Courier, monospace",
          "description": "Font-style to use, entered in css-format.",
          "order": "4"
        },
        "lotjcolor.displayfontsize": {
          "type": "number",
          "default": 0.8125,
          "description": "Size of font in display, entered in em units.",
          "order": "5"
        },
        "lotjcolor.backgroundcolor": {
          "type": "string",
          "default": "#000000",
          "description": "Background color of display, entered in hex format.",
          "order": "6"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "build": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.1",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
